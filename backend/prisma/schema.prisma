// Prisma 7: el cliente no usa motor en Rust; se conecta con el adaptador MariaDB (src/config/prisma.js),
// válido para MySQL (local) y MariaDB (producción). La URL de la base está en prisma.config.js.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id          Int      @id @default(autoincrement())
  uid         String   @unique // Firebase UID o ID propio si es clásico
  email       String   @unique
  displayName String?
  photoURL    String?
  role        String   @default("cliente") // "admin" o "cliente"
  password    String?  // Hash para login clásico
  
  orders      Order[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id               String   @id // Mantener IDs string tipo Firebase si es necesario
  name             String?
  price            Float?
  description      String?  @db.Text
  category         String?
  local_image_path String?
  url_origen       String?
  tipo             String?
  showOnHome       Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int      @default(0)
  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())
}

model Order {
  id                    String   @id @default(uuid())
  redsysOrderId         String?  @unique
  stripeSessionId       String?
  stripePaymentIntent   String?

  // Customer info
  customer_uid          String?
  customer_name         String
  customer_email        String
  customer_phone        String

  // Delivery info
  delivery_address      String
  delivery_city         String
  delivery_zip          String
  delivery_addressOriginal String? @db.Text
  delivery_addressExtra String?
  delivery_date         String
  delivery_timeSlot     String
  delivery_message      String?  @db.Text
  delivery_distanceKm   Float?
  delivery_durationMin  Int?
  delivery_proximity    String?
  delivery_surchargeAmount Float?

  total                 Float
  status                String   @default("pending") // pending, paid, delivered, cancelled
  failedPaymentAttempts Int      @default(0)
  lastStripeErrorId     String?
  // Cuándo se avisó al cliente de que el pago no se completó (el correo se envía una sola vez)
  paymentIssueEmailAt   DateTime?

  items                 OrderItem[]
  user                  User?       @relation(fields: [customer_uid], references: [uid])

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   String
  productId String?
  name      String
  price     Float
  quantity  Int
  
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Campaign {
  id        String   @id @default(uuid())
  title     String
  subject   String
  content   String   @db.Text
  status    String   @default("draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offer {
  id              String    @id @default(uuid())
  title           String
  description     String?
  code            String?
  discountPercent Float?
  active          Boolean   @default(true)
  type            String    @default("banner")
  imageUrl        String?
  validUntil      DateTime?
  backgroundImage String?
  backgroundColor String?
  productId       String?
  ribbonText      String?
  ribbonColor     String?
  ribbonTextColor String?
  // Colores de los textos de banners y cupones, y % de descuento como banda en la esquina
  titleColor       String?
  descriptionColor String?
  badgeColor       String?
  codeColor        String?
  discountCorner   Boolean   @default(false)
  discountColor    String?
  discountBgColor  String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Configuration {
  id    String @id
  value Json
}

// Bloqueo por fecha de entrega para reservar horas sin solaparse (una fila por nombre, p. ej. "slot:2026-10-03").
// Se bloquea la fila dentro de una transacción y el bloqueo se libera solo al terminar esta (src/config/prisma.js).
model SlotLock {
  name String @id
}
